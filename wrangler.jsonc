{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "listen6-landing-page",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "listen6.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
